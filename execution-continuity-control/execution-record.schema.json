{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:execution-continuity-control:execution-record:1",
  "title": "Execution Continuity Project Record",
  "type": "object",
  "required": ["format_version", "created_at", "updated_at", "snapshot", "project", "entries"],
  "properties": {
    "format_version": {"const": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "snapshot": {"$ref": "#/$defs/snapshot"},
    "project": {"$ref": "#/$defs/project"},
    "entries": {"type": "array", "items": {"$ref": "#/$defs/entry"}}
  },
  "additionalProperties": false,
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "recordFilename": {"type": "string", "pattern": "^execution-record_[0-9]{8}T[0-9]{12}Z\\.json$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "snapshot": {
      "type": "object",
      "required": ["timestamp", "filename", "predecessor_filename", "predecessor_sha256"],
      "properties": {
        "timestamp": {"type": "string", "pattern": "^[0-9]{8}T[0-9]{12}Z$"},
        "filename": {"$ref": "#/$defs/recordFilename"},
        "predecessor_filename": {"oneOf": [{"$ref": "#/$defs/recordFilename"}, {"type": "null"}]},
        "predecessor_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
      },
      "additionalProperties": false
    },
    "project": {
      "type": "object",
      "required": ["project_id", "project_title"],
      "properties": {
        "project_id": {"$ref": "#/$defs/text"},
        "project_title": {"$ref": "#/$defs/text"}
      },
      "additionalProperties": false
    },
    "entry": {
      "type": "object",
      "required": ["entry_id", "sequence", "recorded_at", "chat_id", "chat_title", "event", "outcome", "evidence"],
      "properties": {
        "entry_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
        "sequence": {"type": "integer", "minimum": 1},
        "recorded_at": {"type": "string", "format": "date-time"},
        "chat_id": {"$ref": "#/$defs/text"},
        "chat_title": {"$ref": "#/$defs/text"},
        "event": {"$ref": "#/$defs/text"},
        "outcome": {"$ref": "#/$defs/text"},
        "evidence": {"$ref": "#/$defs/text"}
      },
      "additionalProperties": false
    }
  }
}
