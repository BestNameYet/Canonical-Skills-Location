{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "execution-record.schema.json",
  "title": "Execution Continuity Project Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "snapshot_created_at",
    "predecessor",
    "actions"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "snapshot_created_at": {
      "type": "string",
      "format": "date-time"
    },
    "predecessor": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "filename",
            "sha256"
          ],
          "properties": {
            "filename": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      ]
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/action"
      }
    }
  },
  "$defs": {
    "answer": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "chat_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "chat_title": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "question_pair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "question",
        "answer"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "answer": {
          "$ref": "#/$defs/answer"
        }
      }
    },
    "action_questionnaire_pairs": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": false,
      "prefixItems": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "question",
            "answer"
          ],
          "properties": {
            "id": {
              "const": "AQ1"
            },
            "question": {
              "const": "What just occurred?"
            },
            "answer": {
              "$ref": "#/$defs/answer"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "question",
            "answer"
          ],
          "properties": {
            "id": {
              "const": "AQ2"
            },
            "question": {
              "const": "What type was it?"
            },
            "answer": {
              "$ref": "#/$defs/answer"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "question",
            "answer"
          ],
          "properties": {
            "id": {
              "const": "AQ3"
            },
            "question": {
              "const": "Why did it occur?"
            },
            "answer": {
              "$ref": "#/$defs/answer"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "question",
            "answer"
          ],
          "properties": {
            "id": {
              "const": "AQ4"
            },
            "question": {
              "const": "What did it operate on?"
            },
            "answer": {
              "$ref": "#/$defs/answer"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "question",
            "answer"
          ],
          "properties": {
            "id": {
              "const": "AQ5"
            },
            "question": {
              "const": "What actually happened?"
            },
            "answer": {
              "$ref": "#/$defs/answer"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "question",
            "answer"
          ],
          "properties": {
            "id": {
              "const": "AQ6"
            },
            "question": {
              "const": "What artifacts or state changed?"
            },
            "answer": {
              "$ref": "#/$defs/answer"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "question",
            "answer"
          ],
          "properties": {
            "id": {
              "const": "AQ7"
            },
            "question": {
              "const": "What is its status?"
            },
            "answer": {
              "$ref": "#/$defs/answer"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "question",
            "answer"
          ],
          "properties": {
            "id": {
              "const": "AQ8"
            },
            "question": {
              "const": "What evidence supports that status or result?"
            },
            "answer": {
              "$ref": "#/$defs/answer"
            }
          }
        }
      ]
    },
    "recorded_action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_type",
        "sequence",
        "recorded_at",
        "scope",
        "action",
        "result"
      ],
      "properties": {
        "action_type": {
          "const": "recorded_action"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        },
        "scope": {
          "type": "string",
          "enum": [
            "worker",
            "orchestrator"
          ]
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      }
    },
    "action_questionnaire": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_type",
        "sequence",
        "recorded_at",
        "scope",
        "subject_sequence",
        "pairs"
      ],
      "properties": {
        "action_type": {
          "const": "action_questionnaire"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        },
        "scope": {
          "type": "string",
          "enum": [
            "worker",
            "orchestrator"
          ]
        },
        "subject_sequence": {
          "type": "integer",
          "minimum": 1
        },
        "pairs": {
          "$ref": "#/$defs/action_questionnaire_pairs"
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      }
    },
    "router_cycle_action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_type",
        "sequence",
        "recorded_at",
        "scope",
        "pairs",
        "directive"
      ],
      "properties": {
        "action_type": {
          "const": "router_cycle"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        },
        "scope": {
          "type": "string",
          "enum": [
            "worker",
            "orchestrator"
          ]
        },
        "cycle_id": {
          "type": "string",
          "minLength": 1
        },
        "pairs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/question_pair"
          }
        },
        "directive": {
          "type": "string",
          "enum": [
            "CONTINUE",
            "COMPLETE",
            "IMPASSE"
          ]
        },
        "instruction": {
          "type": "string",
          "minLength": 1
        },
        "impasse_evidence": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "directive": {
                "const": "CONTINUE"
              }
            },
            "required": [
              "directive"
            ]
          },
          "then": {
            "required": [
              "instruction"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "directive": {
                "const": "IMPASSE"
              }
            },
            "required": [
              "directive"
            ]
          },
          "then": {
            "required": [
              "impasse_evidence"
            ]
          }
        }
      ]
    },
    "action": {
      "oneOf": [
        {
          "$ref": "#/$defs/recorded_action"
        },
        {
          "$ref": "#/$defs/action_questionnaire"
        },
        {
          "$ref": "#/$defs/router_cycle_action"
        }
      ]
    }
  }
}
