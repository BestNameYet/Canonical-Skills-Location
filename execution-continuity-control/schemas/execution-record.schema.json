{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "execution-record.schema.json",
  "title": "Execution Continuity Project Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_id", "snapshot_created_at", "predecessor", "actions"],
  "properties": {
    "record_id": {"type": "string", "minLength": 1},
    "snapshot_created_at": {"type": "string", "format": "date-time"},
    "predecessor": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["filename", "sha256"],
          "properties": {
            "filename": {"type": "string", "minLength": 1},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        }
      ]
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/action"}
    }
  },
  "$defs": {
    "answer": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "chat_id": {"type": ["string", "null"]},
        "chat_title": {"type": ["string", "null"]}
      }
    },
    "pair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "question", "answer"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "question": {"type": "string", "minLength": 1},
        "answer": {"$ref": "#/$defs/answer"}
      }
    },
    "questionnaire_pairs": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": false,
      "prefixItems": [
        {"allOf": [{"$ref": "#/$defs/pair"}, {"properties": {"id": {"const": "AQ1"}, "question": {"const": "What just occurred?"}}}]},
        {"allOf": [{"$ref": "#/$defs/pair"}, {"properties": {"id": {"const": "AQ2"}, "question": {"const": "Is this action an end-of-turn attempt? Answer YES or NO."}, "answer": {"enum": ["YES", "NO"]}}}]},
        {"allOf": [{"$ref": "#/$defs/pair"}, {"properties": {"id": {"const": "AQ3"}, "question": {"const": "Why did it occur?"}}}]},
        {"allOf": [{"$ref": "#/$defs/pair"}, {"properties": {"id": {"const": "AQ4"}, "question": {"const": "What did it operate on?"}}}]},
        {"allOf": [{"$ref": "#/$defs/pair"}, {"properties": {"id": {"const": "AQ5"}, "question": {"const": "What actually happened?"}}}]},
        {"allOf": [{"$ref": "#/$defs/pair"}, {"properties": {"id": {"const": "AQ6"}, "question": {"const": "What artifacts or state changed?"}}}]},
        {"allOf": [{"$ref": "#/$defs/pair"}, {"properties": {"id": {"const": "AQ7"}, "question": {"const": "What is its status?"}}}]},
        {"allOf": [{"$ref": "#/$defs/pair"}, {"properties": {"id": {"const": "AQ8"}, "question": {"const": "What evidence supports that status or result?"}}}]}
      ]
    },
    "router_cycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cycle_id", "scope", "pairs", "directive"],
      "properties": {
        "cycle_id": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "enum": ["worker", "orchestrator"]},
        "pairs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/pair"}},
        "directive": {"type": "string", "enum": ["CONTINUE", "COMPLETE", "IMPASSE"]},
        "instruction": {"type": "string", "minLength": 1},
        "impasse_evidence": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {"if": {"properties": {"directive": {"const": "CONTINUE"}}, "required": ["directive"]}, "then": {"required": ["instruction"]}},
        {"if": {"properties": {"directive": {"const": "IMPASSE"}}, "required": ["directive"]}, "then": {"required": ["impasse_evidence"]}}
      ]
    },
    "recorder_invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_type", "sequence", "recorded_at", "scope"],
      "properties": {
        "action_type": {"const": "recorder_invocation"},
        "sequence": {"type": "integer", "minimum": 1},
        "recorded_at": {"type": "string", "format": "date-time"},
        "scope": {"type": "string", "enum": ["worker", "orchestrator"]},
        "source": {"$ref": "#/$defs/source"}
      }
    },
    "action_questionnaire": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_type", "sequence", "recorded_at", "scope", "pairs"],
      "properties": {
        "action_type": {"const": "action_questionnaire"},
        "sequence": {"type": "integer", "minimum": 1},
        "recorded_at": {"type": "string", "format": "date-time"},
        "scope": {"type": "string", "enum": ["worker", "orchestrator"]},
        "pairs": {"$ref": "#/$defs/questionnaire_pairs"},
        "source": {"$ref": "#/$defs/source"}
      }
    },
    "end_turn_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_type", "sequence", "recorded_at", "scope", "router_cycle"],
      "properties": {
        "action_type": {"const": "end_turn_result"},
        "sequence": {"type": "integer", "minimum": 1},
        "recorded_at": {"type": "string", "format": "date-time"},
        "scope": {"type": "string", "enum": ["worker", "orchestrator"]},
        "router_cycle": {"$ref": "#/$defs/router_cycle"},
        "source": {"$ref": "#/$defs/source"}
      }
    },
    "action": {
      "oneOf": [
        {"$ref": "#/$defs/recorder_invocation"},
        {"$ref": "#/$defs/action_questionnaire"},
        {"$ref": "#/$defs/end_turn_result"}
      ]
    }
  }
}
